{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_CHECKPOINT3_TEST": "false" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_CHECKPOINT3_TEST": "false" }
    },
    "checkpoint3-test": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_CHECKPOINT3_TEST": "true" }
    }
  }
}
