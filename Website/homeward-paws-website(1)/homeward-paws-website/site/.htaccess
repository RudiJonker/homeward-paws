ErrorDocument 404 /paws/404.html

# The public pages moved to homewardpaws.org.za on 31 Oct 2026 (query strings are kept).
# The beta, its download, the dashboard and the email confirmation fallback stay here.
RedirectMatch 301 ^/paws/(index\.html)?$ https://homewardpaws.org.za/
RedirectMatch 301 ^/paws/(nearby|safety|privacy-policy|terms|child-safety|delete-account)\.html$ https://homewardpaws.org.za/$1.html
RedirectMatch 301 ^/paws/(sitemap\.xml|robots\.txt|app-ads\.txt)$ https://homewardpaws.org.za/$1

# Security headers for /paws (28 Oct 2026). Scripts may only come from files on this site
# (script-src 'self'): no inline <script> code. hp-deploy blocks a deploy that adds one.
# HSTS starts at one month; raise to max-age=31536000 once it has run without issues.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=2592000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://krpihktxtivossbfuziq.supabase.co; connect-src 'self' https://krpihktxtivossbfuziq.supabase.co; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>
